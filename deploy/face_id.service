# =============================================================================
# Systemd Service for Face ID (Employee Attendance System)
#
# Installation:
#   sudo cp deploy/face_id.service /etc/systemd/system/face_id.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable face_id
#   sudo systemctl start face_id
#
# Management:
#   sudo systemctl status face_id    # Check status
#   sudo systemctl restart face_id   # Restart
#   sudo journalctl -u face_id -f   # View live logs
# =============================================================================

[Unit]
Description=Face ID - Employee Attendance System
After=network.target

[Service]
# ---- Change these to match your server ----
User=suxrob
Group=suxrob
WorkingDirectory=/home/suxrob/Documents/face_id
Environment="PATH=/home/suxrob/Documents/face_id/venv/bin:/usr/local/bin:/usr/bin"
Environment="ENV=prod"

# Run command
ExecStart=/home/suxrob/Documents/face_id/venv/bin/python main.py

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
