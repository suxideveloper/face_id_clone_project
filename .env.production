# ========== PRODUCTION CONFIG ==========
# Copy this to .env on your production server
# cp .env.production .env

ENV=prod

# IMPORTANT: Generate a strong secret key!
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# Browser camera mode (getUserMedia)
CAMERA_MODE=client

# YOLO model
YOLO_MODEL=yolov8n-face.pt

# Production domain
CORS_ORIGINS=https://faceid.airi.uz,http://localhost:8080
ALLOWED_HOSTS=faceid.airi.uz,localhost,127.0.0.1
