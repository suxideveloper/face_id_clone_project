# ========== Environment ==========
# "dev" for development, "prod" for production
ENV=dev

# Secret key for session security — generate a strong random string for production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-strong-random-key

# ========== Camera Settings ==========
# Set to 0, 1, 2 for webcam index
# Set to 'rtsp://user:pass@ip:port/stream' for IP Camera
CAMERA_ID=0

# RTSP URL for IP camera (if using RTSP)
RTSP_URL=rtsp://user:password@192.168.1.100:554/Streaming/Channels/401

# ========== Model Settings ==========
# Path to YOLO model
YOLO_MODEL=yolov8n-face.pt

# ========== Network / Security ==========
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://10.10.0.129

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,10.10.0.129
